# LIFE MAP — variables d'environnement (copier en .env.local, ne jamais committer .env.local)
# Seules les variables préfixées EXPO_PUBLIC_ sont embarquées dans l'app : n'y mettez QUE des clés publiques.

# Supabase (Phase 3). Sans ces deux valeurs, l'app tourne en MODE DÉMO (données locales sur l'appareil).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Ne JAMAIS mettre la clé "service_role" de Supabase dans l'application mobile.
